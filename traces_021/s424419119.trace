s424419119.py(14):         INF = float('inf')
s424419119.py(15):         self.dist = [INF] * self.N # the distance of each vertex from s
s424419119.py(16):         self.prev = [-1] * self.N # the previous vertex of each vertex on a shortest path from s
s424419119.py(17):         visited = [False] * self.N
s424419119.py(18):         n_visited = 0 # #(visited vertices)
s424419119.py(19):         heap = []
s424419119.py(20):         heappush(heap, (0, -1, s))
s424419119.py(21):         while heap:
s424419119.py(22):             d, p, v = heappop(heap)
s424419119.py(23):             if visited[v]: continue # (s,v)-shortest path is already calculated
s424419119.py(24):             self.dist[v] = d; self.prev[v] = p; visited[v] = True
s424419119.py(25):             n_visited += 1
s424419119.py(26):             if n_visited == self.N: break
s424419119.py(27):             for u, c in self.E[v]:
s424419119.py(28):                 if visited[u]: continue
s424419119.py(29):                 temp = d + c
s424419119.py(30):                 if self.dist[u] > temp: heappush(heap, (temp, v, u))
s424419119.py(27):             for u, c in self.E[v]:

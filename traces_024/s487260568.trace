s487260568.py(15):         self.order = [-1] * self.N # a bfs ordering of each vertex
s487260568.py(16):         self.dist = [-1] * self.N # the distance of each vertex from s
s487260568.py(17):         dq = deque([(s, 0)]) # (vertex, dist)
s487260568.py(18):         num = 0 # current ordering
s487260568.py(19):         while dq:

s022994990.py(5):     N = len(E)
s022994990.py(6):     order = [-1] * N # a bfs ordering of each vertex
s022994990.py(7):     dist = [-1] * N # the distance of each vertex from s
s022994990.py(8):     dq = deque([(s, init)]) # (vertex, dist)
s022994990.py(9):     num = 0 # current ordering
s022994990.py(10):     while dq:
s022994990.py(11):         v, d = dq.popleft()
s022994990.py(12):         if order[v] < 0: # visited v for the first time
s022994990.py(13):             order[v] = num; dist[v] = d
s022994990.py(14):             num += 1
s022994990.py(15):             for u, w in E[v]:
s022994990.py(16):                 if order[u] >= 0: continue
s022994990.py(17):                 if w == 0: dq.appendleft((u, d))

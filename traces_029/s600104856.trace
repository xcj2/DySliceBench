s600104856.py(9):     for i_1,j_1,k_1 in permutation:
s600104856.py(10):         A = abc[i_1]
s600104856.py(11):         B = abc[j_1]
s600104856.py(12):         C = abc[k_1]
s600104856.py(13):         LENA = len(A)
s600104856.py(14):         LENB = len(B)
s600104856.py(15):         LENC = len(C)
s600104856.py(17):         AB = [False]*(LENA+1)
s600104856.py(18):         BC = [False]*LENB+[True]*2010
s600104856.py(19):         AC = [False]*(LENA)+[True]*(2010)
s600104856.py(20):         AB[LENA] = True

s254872465.py(14):         INF = float('inf')
s254872465.py(15):         self.dist = [INF] * self.N # the distance of each vertex from s
s254872465.py(16):         self.prev = [-1] * self.N # the previous vertex of each vertex on a shortest path from s
s254872465.py(17):         rem = self.N # #(remaining vertices)
s254872465.py(18):         heap = []
s254872465.py(19):         heappush(heap, (0, -1, s))
s254872465.py(20):         while heap and rem:
s254872465.py(21):             d, p, v = heappop(heap)
s254872465.py(22):             if d >= self.dist[v]: continue # (s,v)-shortest path is already calculated
s254872465.py(23):             self.dist[v] = d; self.prev[v] = p
s254872465.py(24):             rem -= 1
s254872465.py(25):             for u, c in self.E[v]:
s254872465.py(26):                 temp = d + c
s254872465.py(27):                 if self.dist[u] > temp: heappush(heap, (temp, v, u))
s254872465.py(25):             for u, c in self.E[v]:
